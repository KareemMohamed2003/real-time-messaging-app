generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Users {
  id          Int        @id @default(autoincrement())
  createdAt   DateTime   @default(now())
  username    String     @unique
  email       String     @unique
  password    String
  uuid        String     @default(uuid())
  profile_img Bytes?     @db.MediumBlob //? makes fieldss optional
  status      Int        @default(1) @db.TinyInt // 0 offline // 1 online 
  messages    Messages[]
  friendBy    Friends[]  @relation("userAsFriend")
  friends     Friends[]  @relation("userAsSender")
  // posts     Post[]
  // rooms       rooms[]  @relation(fields: [uuid],references: [roomuuid])
  // age       Int
  // country   String 
  // status  
  // notifications []
  // rooms    rooms[]
  // friends  []
  // Friends Friends[]
}

// user a : sara user b : john 
// user a -> user b ., friend_id : john  userId:sara, status:sent 
// user b -> user friend_id:sara userId:john
enum friend_request_enum {
  SENT
  REJECTED
  ACCEPTED
}

model Friends {
  id             Int                 @id @default(autoincrement())
  createdAt      DateTime            @default(now())
  senderName     String
  receiverId     Int //  we may remove this field later since we are gonna add friend_name later 
  email          String // we may not need this also 
  receiverName   String
  // friendship_status Boolean
  request_status friend_request_enum
  // 0 :sent , 1:approved 2:rejected . null 
  // rooms     rooms[] 
  Friend         Users?              @relation("userAsFriend", fields: [receiverId], references: [id])
  Users          Users?              @relation("userAsSender", fields: [senderId], references: [id])
  senderId       Int?

  @@unique([senderId, receiverId])
}

model Messages {
  id         Int      @id @default(autoincrement())
  messageId  String   @default(uuid())
  senderId   String
  recieverId String
  createdAt  DateTime @default(now())
  Users      Users?   @relation(fields: [userId], references: [id])
  userId     Int?
  // user // realtion  
}

model Notifications {
  notificationId   Int      @id @default(autoincrement())
  notificationType String
  senderId         String
  receiverId       String
  message          String
  entity           String
  entityId         String
  createdAt        DateTime @default(now())
}

