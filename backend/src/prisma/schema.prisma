generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Users {
  id              Int          @id @default(autoincrement())
  createdAt       DateTime     @default(now())
  username        String       @unique
  email           String       @unique
  password        String
  uuid            String       @unique @default(uuid())
  profile_img     String?
  status          Int          @default(1) @db.TinyInt // 0 offline // 1 online 
  messages        Messages[]
  friendBy        Friends[]    @relation("userAsFriend")
  friends         Friends[]    @relation("userAsSender")
  roomMemberships RoomMember[]
}

// we can add this model later when we decide if there will be restrications on who can view channels in rooms. 
model ChannelParticipant {
  id        Int      @id @default(autoincrement())
  channelId Int
  userId    String
  joinedAt  DateTime @default(now())
  channel   Channel  @relation(fields: [channelId], references: [channelId])

  @@unique([channelId, userId])
}

// user a : sara user b : john 
// user a -> user b ., friend_id : john  userId:sara, status:sent 
// user b -> user friend_id:sara userId:john
enum userRole {
  ADMIN
  OWNER
  MEMBER
}

enum ChannelType {
  TEXT // normal channel in a Room/server
  VOICE
  DIRECT_MESSAGE
}

enum friend_request_enum {
  SENT
  REJECTED
  ACCEPTED
}

model Friends {
  id             Int                 @id @default(autoincrement())
  createdAt      DateTime            @default(now())
  senderName     String
  receiverId     Int //  we may remove this field later since we are gonna add friend_name later 
  email          String // we may not need this also 
  receiverName   String
  request_status friend_request_enum
  receiver       Users?              @relation("userAsFriend", fields: [receiverId], references: [id]) // friendBy
  sender         Users?              @relation("userAsSender", fields: [senderId], references: [id]) // friends
  senderId       Int

  @@unique([senderId, receiverId])
}

model Messages {
  id           Int      @id @default(autoincrement())
  channelId    Int
  senderUUID   String
  receiverUUID String?
  createdAt    DateTime @default(now())
  message      String
  user         Users    @relation(fields: [senderUUID], references: [uuid])
  channel      Channel  @relation(fields: [channelId], references: [channelId])
}

model Notifications {
  notificationId   Int      @id @default(autoincrement())
  notificationType String
  senderId         String
  receiverId       String
  message          String
  entity           String
  entityId         String
  createdAt        DateTime @default(now())
}

model Channel {
  channelId           Int                  @id @default(autoincrement())
  roomUUID            String?
  channelName         String
  type                ChannelType          @default(DIRECT_MESSAGE)
  room                Rooms?               @relation(fields: [roomUUID], references: [roomUUID])
  messages            Messages[]
  channelParticipants ChannelParticipant[]

  @@index([type]) // helps when filtering DMs vs room channels
}

model Rooms {
  roomName String
  roomUUID String       @unique @default(uuid())
  icon     Bytes?
  ownerId  String
  members  RoomMember[]
  channels Channel[]

  @@id([roomName, ownerId])
}

model RoomMember {
  roomUUID String
  userId   String
  role     userRole
  room     Rooms    @relation(fields: [roomUUID], references: [roomUUID])
  user     Users    @relation(fields: [userId], references: [uuid])

  @@id([roomUUID, userId])
}
